{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Recommendation": {
    "Popularity": {
      "WindowDays": 30,
      "DefaultLimit": 10,
      "MaximumLimit": 50,
      "SoldQuantityWeight": 0.50,
      "DistinctOrderWeight": 0.30,
      "RecencyWeight": 0.20
    },
    "FrequentlyBoughtTogether": {
      "DefaultLimit": 10,
      "MaximumLimit": 50,
      "MinimumPairOrderCount": 2,
      "MinimumSupport": 0.01,
      "MinimumConfidence": 0.05,
      "MinimumLift": 1.0
    }
  }
}

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Recommendation": {
    "Popularity": {
      "WindowDays": 30,
      "DefaultLimit": 10,
      "MaximumLimit": 50,
      "SoldQuantityWeight": 0.50,
      "DistinctOrderWeight": 0.30,
      "RecencyWeight": 0.20
    },
    "FrequentlyBoughtTogether": {
      "DefaultLimit": 10,
      "MaximumLimit": 50,
      "MinimumPairOrderCount": 2,
      "MinimumSupport": 0.01,
      "MinimumConfidence": 0.05,
      "MinimumLift": 1.0
    },
    "CartCompletion": {
      "DefaultLimit": 10,
      "MaximumLimit": 50,
      "AffinityScoreWeight": 0.45,
      "ConfidenceWeight": 0.25,
      "LiftWeight": 0.15,
      "SupportingProductWeight": 0.15
    },
    "Similar": {
      "DefaultLimit": 10,
      "MaximumLimit": 50
    }
  },
  "Services": {
    "RecommendationModelService": {
      "BaseAddress": "http://127.0.0.1:8085",
      "ApiKey": "",
      "Timeout": "00:00:03"
    }
  }
}

@model List<OnlineMarket.Web.Application.Models.ProductDto>
@{
    ViewData["Title"] = "Ürün ve Stok Yönetimi";
}

<div class="my-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-box-seam text-primary me-2"></i>Ürün ve Stok Yönetimi</h2>
            <p class="text-secondary small mb-0">Ürün ekleyin, fiyat ve stok miktarlarını güncelleyin.</p>
        </div>
        <div class="d-flex align-items-center gap-2">
            <form asp-action="BulkMatchImages" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary rounded-pill">
                    <i class="bi bi-magic me-1"></i> Görselleri Otomatik Eşleştir
                </button>
            </form>
            <a asp-action="CreateProduct" class="btn btn-primary-custom rounded-pill">
                <i class="bi bi-plus-lg me-1"></i> Yeni Ürün Ekle
            </a>
        </div>
    </div>

    @if (TempData["InfoMessage"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show rounded-4 mb-4" role="alert">
            <i class="bi bi-info-circle me-2"></i>@TempData["InfoMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="card-custom p-4 border-0 shadow-sm rounded-4">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Ürün Adı</th>
                        <th>SKU</th>
                        <th>Kategori / Marka</th>
                        <th>Fiyat</th>
                        <th>Stok Miktarı</th>
                        <th>Durum</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "https://placehold.co/40x40?text=Urun" : p.ImageUrl)" class="rounded" style="width: 40px; height: 40px; object-fit: contain;" />
                                    <strong class="text-dark">@p.Name</strong>
                                </div>
                            </td>
                            <td class="text-secondary small">@p.Sku</td>
                            <td class="text-secondary small">@p.CategoryName / @p.BrandName</td>
                            <td class="fw-bold text-primary">@p.Price.ToString("N2") ₺</td>
                            <td>
                                @if (p.StockQuantity <= 0)
                                {
                                    <span class="badge bg-danger">0 (Tükendi)</span>
                                }
                                else if (p.StockQuantity <= 10)
                                {
                                    <span class="badge bg-warning text-dark">@p.StockQuantity (Kritik)</span>
                                }
                                else
                                {
                                    <span class="badge bg-success">@p.StockQuantity Adet</span>
                                }
                            </td>
                            <td>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success">Aktif</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary">Pasif</span>
                                }
                            </td>
                            <td class="text-end">
                                <a asp-action="AdjustStock" asp-route-id="@p.Id" class="btn btn-sm btn-outline-info rounded-pill me-1" title="Stok Hareketi">
                                    <i class="bi bi-arrow-left-right me-1"></i> Stok
                                </a>
                                <a asp-action="EditProduct" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary rounded-pill" title="Düzenle">
                                    <i class="bi bi-pencil"></i> Düzenle
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

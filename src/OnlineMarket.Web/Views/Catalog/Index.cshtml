@model OnlineMarket.Web.Models.CatalogIndexViewModel
@{
    ViewData["Title"] = "Ürün Kataloğu";
}

<!-- Personalized Recommendations Ribbon -->
@if (Model.PersonalizedRecommendations.Any())
{
    <div class="card-custom p-4 mb-4 bg-white border-0 shadow-sm rounded-4">
        <div class="d-flex align-items-center mb-3">
            <span class="badge-recommendation me-2"><i class="bi bi-stars"></i> Sizin İçin Seçtiklerimiz</span>
            <h5 class="fw-bold mb-0 text-dark">Kişiselleştirilmiş Öneriler</h5>
        </div>
        <div class="row g-3">
            @foreach (var rec in Model.PersonalizedRecommendations)
            {
                if (rec.ProductDetails != null)
                {
                    <div class="col-6 col-md-3">
                        <div class="card-custom h-100 p-3 text-center border-0 shadow-sm bg-light">
                            <img src="@(string.IsNullOrEmpty(rec.ProductDetails.ImageUrl) ? "https://placehold.co/150x150?text=Urun" : rec.ProductDetails.ImageUrl)" class="img-fluid rounded mb-2" style="max-height: 100px; object-fit: contain;" alt="@rec.ProductDetails.Name" />
                            <h6 class="fw-bold text-truncate mb-1">
                                <a asp-action="Details" asp-route-id="@rec.ProductDetails.Id" class="text-dark text-decoration-none">@rec.ProductDetails.Name</a>
                            </h6>
                            <div class="price-tag fs-6 mb-2">@rec.ProductDetails.Price.ToString("N2") ₺</div>
                            <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="productId" value="@rec.ProductDetails.Id" />
                                <button type="submit" class="btn btn-sm btn-primary-custom w-100 rounded-pill"><i class="bi bi-cart-plus me-1"></i> Ekle</button>
                            </form>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<!-- Mobile Filter Trigger & Sort Bar -->
<div class="d-lg-none bg-white p-3 rounded-4 shadow-sm mb-4 border d-flex align-items-center justify-content-between gap-2">
    <button class="btn btn-outline-primary rounded-pill px-3 py-2 font-weight-bold d-flex align-items-center gap-2" type="button" data-bs-toggle="offcanvas" data-bs-target="#offcanvasFilters" aria-controls="offcanvasFilters">
        <i class="bi bi-funnel-fill"></i>
        <span>Filtreler</span>
        @if (Model.SelectedCategoryId != null || Model.SelectedBrandId != null || !string.IsNullOrEmpty(Model.SearchQuery) || Model.MinPrice != null || Model.MaxPrice != null)
        {
            <span class="badge bg-primary rounded-pill">Aktif</span>
        }
    </button>

    <form asp-action="Index" method="get" class="d-flex align-items-center gap-1">
        <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
        <input type="hidden" name="brandId" value="@Model.SelectedBrandId" />
        <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />
        <input type="hidden" name="minPrice" value="@Model.MinPrice" />
        <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
        <input type="hidden" name="inStockOnly" value="@(Model.InStockOnly ? "true" : "false")" />
        <select name="sortBy" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
            <option value="newest" selected="@(Model.SortBy == "newest")">En Yeniler</option>
            <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Fiyat: Düşükten Yükseğe</option>
            <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Fiyat: Yüksekten Düşüğe</option>
            <option value="name" selected="@(Model.SortBy == "name")">İsme Göre (A-Z)</option>
        </select>
    </form>
</div>

<!-- Offcanvas Filter Drawer for Mobile -->
<div class="offcanvas offcanvas-start offcanvas-custom d-lg-none" tabindex="-1" id="offcanvasFilters" aria-labelledby="offcanvasFiltersLabel">
    <div class="offcanvas-header offcanvas-header-custom p-3">
        <h5 class="offcanvas-title text-white fw-bold" id="offcanvasFiltersLabel"><i class="bi bi-funnel me-2"></i>Filtrele</h5>
        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Kapat"></button>
    </div>
    <div class="offcanvas-body p-4">
        <form asp-action="Index" method="get">
            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">Arama</label>
                <input type="text" name="searchQuery" class="form-control rounded-3" placeholder="Ürün adı..." value="@Model.SearchQuery" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">Kategori</label>
                <select name="categoryId" class="form-select rounded-3">
                    <option value="">Tüm Kategoriler</option>
                    @foreach (var parent in Model.Categories.Where(c => c.ParentCategoryId == null))
                    {
                        <option value="@parent.Id" selected="@(Model.SelectedCategoryId == parent.Id)" class="fw-bold">📁 @parent.Name (Ana Kategori)</option>
                        if (parent.SubCategories != null && parent.SubCategories.Any())
                        {
                            <optgroup label="── @parent.Name Alt Kategorileri">
                                @foreach (var sub in parent.SubCategories)
                                {
                                    <option value="@sub.Id" selected="@(Model.SelectedCategoryId == sub.Id)">└─ @sub.Name</option>
                                }
                            </optgroup>
                        }
                    }
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold text-secondary small">Marka</label>
                <select name="brandId" class="form-select rounded-3">
                    <option value="">Tüm Markalar</option>
                    @foreach (var brand in Model.Brands)
                    {
                        <option value="@brand.Id" selected="@(Model.SelectedBrandId == brand.Id)">@brand.Name</option>
                    }
                </select>
            </div>

            <div class="row mb-3">
                <div class="col-6">
                    <label class="form-label fw-semibold text-secondary small">Min ₺</label>
                    <input type="number" step="0.01" name="minPrice" class="form-control rounded-3" value="@Model.MinPrice" />
                </div>
                <div class="col-6">
                    <label class="form-label fw-semibold text-secondary small">Max ₺</label>
                    <input type="number" step="0.01" name="maxPrice" class="form-control rounded-3" value="@Model.MaxPrice" />
                </div>
            </div>

            <div class="form-check mb-4">
                <input class="form-check-input" type="checkbox" name="inStockOnly" value="true" id="inStockOnlyMobile" checked="@Model.InStockOnly" />
                <label class="form-check-label text-secondary small" for="inStockOnlyMobile">Sadece Stokta Olanlar</label>
            </div>

            <div class="d-grid gap-2">
                <button type="submit" class="btn btn-primary-custom py-2 rounded-pill font-weight-bold">Filtreleri Uygula</button>
                <a asp-action="Index" class="btn btn-outline-secondary py-2 rounded-pill">Temizle</a>
            </div>
        </form>
    </div>
</div>

<div class="row g-4 my-2">
    <!-- Desktop Sidebar Filters -->
    <div class="col-lg-3 d-none d-lg-block">
        <div class="card-custom p-4 sticky-top" style="top: 90px; z-index: 10;">
            <h5 class="fw-bold mb-3"><i class="bi bi-funnel text-primary me-2"></i>Filtreler</h5>
            
            <form asp-action="Index" method="get">
                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Arama</label>
                    <input type="text" name="searchQuery" class="form-control rounded-3" placeholder="Ürün adı..." value="@Model.SearchQuery" />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Kategori</label>
                    <select name="categoryId" class="form-select rounded-3">
                        <option value="">Tüm Kategoriler</option>
                        @foreach (var parent in Model.Categories.Where(c => c.ParentCategoryId == null))
                        {
                            <option value="@parent.Id" selected="@(Model.SelectedCategoryId == parent.Id)" class="fw-bold">📁 @parent.Name (Ana Kategori)</option>
                            if (parent.SubCategories != null && parent.SubCategories.Any())
                            {
                                <optgroup label="── @parent.Name Alt Kategorileri">
                                    @foreach (var sub in parent.SubCategories)
                                    {
                                        <option value="@sub.Id" selected="@(Model.SelectedCategoryId == sub.Id)">└─ @sub.Name</option>
                                    }
                                </optgroup>
                            }
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold text-secondary small">Marka</label>
                    <select name="brandId" class="form-select rounded-3">
                        <option value="">Tüm Markalar</option>
                        @foreach (var brand in Model.Brands)
                        {
                            <option value="@brand.Id" selected="@(Model.SelectedBrandId == brand.Id)">@brand.Name</option>
                        }
                    </select>
                </div>

                <div class="row mb-3">
                    <div class="col-6">
                        <label class="form-label fw-semibold text-secondary small">Min ₺</label>
                        <input type="number" step="0.01" name="minPrice" class="form-control rounded-3" value="@Model.MinPrice" />
                    </div>
                    <div class="col-6">
                        <label class="form-label fw-semibold text-secondary small">Max ₺</label>
                        <input type="number" step="0.01" name="maxPrice" class="form-control rounded-3" value="@Model.MaxPrice" />
                    </div>
                </div>

                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="inStockOnly" value="true" id="inStockOnly" checked="@Model.InStockOnly" />
                    <label class="form-check-label text-secondary small" for="inStockOnly">Sadece Stokta Olanlar</label>
                </div>

                <div class="d-grid gap-2">
                    <button type="submit" class="btn btn-primary-custom rounded-pill">Filtreleri Uygula</button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill">Temizle</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Product Grid -->
    <div class="col-lg-9">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-bold mb-0 fs-4 fs-md-3">Ürünler</h3>
                <p class="text-secondary small mb-0">Toplam @Model.TotalItems ürün listelendi. (Sayfa @Model.CurrentPage / @(Model.TotalPages > 0 ? Model.TotalPages : 1))</p>
            </div>
            <form asp-action="Index" method="get" class="d-none d-lg-flex align-items-center gap-2">
                <input type="hidden" name="categoryId" value="@Model.SelectedCategoryId" />
                <input type="hidden" name="brandId" value="@Model.SelectedBrandId" />
                <input type="hidden" name="searchQuery" value="@Model.SearchQuery" />
                <input type="hidden" name="minPrice" value="@Model.MinPrice" />
                <input type="hidden" name="maxPrice" value="@Model.MaxPrice" />
                <input type="hidden" name="inStockOnly" value="@(Model.InStockOnly ? "true" : "false")" />
                <span class="text-secondary small text-nowrap">Sırala:</span>
                <select name="sortBy" class="form-select form-select-sm rounded-pill" onchange="this.form.submit()">
                    <option value="newest" selected="@(Model.SortBy == "newest")">En Yeniler</option>
                    <option value="price_asc" selected="@(Model.SortBy == "price_asc")">Fiyat: Düşükten Yükseğe</option>
                    <option value="price_desc" selected="@(Model.SortBy == "price_desc")">Fiyat: Yüksekten Düşüğe</option>
                    <option value="name" selected="@(Model.SortBy == "name")">İsme Göre (A-Z)</option>
                </select>
            </form>
        </div>

        @if (!Model.Products.Any())
        {
            <div class="card-custom p-5 text-center my-4">
                <i class="bi bi-search display-3 text-secondary"></i>
                <h4 class="fw-bold mt-3">Ürün Bulunamadı</h4>
                <p class="text-secondary">Arama kriterlerinize uygun ürün bulunamadı. Lütfen filtreleri değiştirin.</p>
                <a asp-action="Index" class="btn btn-primary-custom rounded-pill mt-2">Tüm Ürünleri Göster</a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var product in Model.Products)
                {
                    <div class="col-6 col-md-4">
                        <div class="card-custom h-100 d-flex flex-column p-3">
                            <div class="position-relative text-center mb-3">
                                @if (!product.IsInStock)
                                {
                                    <span class="badge bg-danger position-absolute top-0 start-0 m-2">Stokta Yok</span>
                                }
                                <img src="@(string.IsNullOrEmpty(product.ImageUrl) ? "https://placehold.co/200x200?text=Urun" : product.ImageUrl)" class="img-fluid rounded" style="max-height: 160px; object-fit: contain;" alt="@product.Name" />
                            </div>

                            <span class="text-secondary small fw-semibold">@product.CategoryName • @product.BrandName</span>
                            <h6 class="fw-bold text-dark mt-1 mb-2">
                                <a asp-action="Details" asp-route-id="@product.Id" class="text-dark text-decoration-none">@product.Name</a>
                            </h6>

                            <div class="mt-auto pt-2 border-top d-flex align-items-center justify-content-between">
                                <div>
                                    <div class="price-tag">@product.Price.ToString("N2") ₺</div>
                                    <div class="vat-info">+%@product.VatRate KDV</div>
                                </div>

                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@product.Id" />
                                    <button type="submit" class="btn btn-primary-custom rounded-circle p-2" @(product.IsInStock ? "" : "disabled") title="Sepete Ekle">
                                        <i class="bi bi-cart-plus fs-5"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>

            <!-- Pagination Controls -->
            @if (Model.TotalPages > 1)
            {
                <nav class="mt-5 d-flex justify-content-center" aria-label="Sayfalama">
                    <ul class="pagination pagination-rounded gap-1">
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-item-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)"
                               asp-route-categoryId="@Model.SelectedCategoryId"
                               asp-route-brandId="@Model.SelectedBrandId"
                               asp-route-searchQuery="@Model.SearchQuery"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-inStockOnly="@Model.InStockOnly"
                               asp-route-sortBy="@Model.SortBy">
                                <i class="bi bi-chevron-left"></i> Önceki
                            </a>
                        </li>

                        @for (int i = 1; i <= Model.TotalPages; i++)
                        {
                            <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                <a class="page-item-link" asp-action="Index"
                                   asp-route-page="@i"
                                   asp-route-categoryId="@Model.SelectedCategoryId"
                                   asp-route-brandId="@Model.SelectedBrandId"
                                   asp-route-searchQuery="@Model.SearchQuery"
                                   asp-route-minPrice="@Model.MinPrice"
                                   asp-route-maxPrice="@Model.MaxPrice"
                                   asp-route-inStockOnly="@Model.InStockOnly"
                                   asp-route-sortBy="@Model.SortBy">@i</a>
                            </li>
                        }

                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-item-link" asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)"
                               asp-route-categoryId="@Model.SelectedCategoryId"
                               asp-route-brandId="@Model.SelectedBrandId"
                               asp-route-searchQuery="@Model.SearchQuery"
                               asp-route-minPrice="@Model.MinPrice"
                               asp-route-maxPrice="@Model.MaxPrice"
                               asp-route-inStockOnly="@Model.InStockOnly"
                               asp-route-sortBy="@Model.SortBy">
                                Sonraki <i class="bi bi-chevron-right"></i>
                            </a>
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>

@model OnlineMarket.Web.Application.Models.OrderDto
@{
    ViewData["Title"] = $"Sipariş #{Model.OrderNumber}";
}

<div class="my-4">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-secondary small"><i class="bi bi-arrow-left me-1"></i> Tüm Siparişlere Dön</a>
            <h2 class="fw-bold mb-0 mt-1">Sipariş Detayı: #@Model.OrderNumber</h2>
        </div>
        <span class="status-pill status-completed fs-6"><i class="bi bi-check-circle-fill me-1"></i> Market Siparişi Onaylandı</span>
    </div>

    <!-- ERP Transfer Status Panel -->
    <div class="card-custom p-4 mb-4 bg-light border-0 shadow-sm rounded-4">
        <h5 class="fw-bold mb-2"><i class="bi bi-diagram-3 text-primary me-2"></i>ERP Entegrasyon Transfer Durumu</h5>
        <p class="text-secondary small mb-3">Bu durum <code>ErpIntegration.Api</code> servisinden anlık olarak sorgulanmaktadır ve pazar sipariş durumunu etkilemez.</p>

        @if (Model.ErpTransferStatus != null)
        {
            <div class="d-flex align-items-center gap-3">
                <span class="status-pill @(Model.ErpTransferStatus.Status == "Completed" ? "status-completed" : Model.ErpTransferStatus.Status == "Failed" ? "status-failed" : "status-processing")">
                    ERP Durumu: @Model.ErpTransferStatus.Status
                </span>
                @if (!string.IsNullOrEmpty(Model.ErpTransferStatus.CurrentStep))
                {
                    <span class="badge bg-secondary">Mevcut Adım: @Model.ErpTransferStatus.CurrentStep</span>
                }
                @if (Model.ErpTransferStatus.LastAttemptAtUtc.HasValue)
                {
                    <span class="text-secondary small">Son Deneme: @Model.ErpTransferStatus.LastAttemptAtUtc.Value.ToLocalTime().ToString("g")</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(Model.ErpTransferStatus.ErrorMessage))
            {
                <div class="alert alert-warning mb-0 mt-2 p-2 small">
                    <i class="bi bi-exclamation-triangle me-1"></i> @Model.ErpTransferStatus.ErrorMessage
                </div>
            }
        }
        else
        {
            <span class="text-secondary small">ERP Entegrasyon durumu henüz işleniyor veya outbox gönderimi bekleniyor.</span>
        }
    </div>

    <div class="row g-4">
        <!-- Order Items -->
        <div class="col-lg-8">
            <div class="card-custom p-4 border-0 shadow-sm rounded-4">
                <h5 class="fw-bold mb-3">Sipariş Edilen Ürünler</h5>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Ürün Adı</th>
                                <th>SKU</th>
                                <th class="text-center">Birim Fiyat</th>
                                <th class="text-center">Adet</th>
                                <th class="text-end">Line Toplam</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@item.ProductNameSnapshot</td>
                                    <td class="text-secondary small">@item.ProductSkuSnapshot</td>
                                    <td class="text-center">
                                        <span>@item.UnitPriceSnapshot.ToString("N2") ₺</span>
                                        <span class="d-block vat-info">+%@item.VatRateSnapshot KDV</span>
                                    </td>
                                    <td class="text-center fw-bold">@item.Quantity</td>
                                    <td class="text-end fw-bold text-primary">
                                        @item.LineTotal.ToString("N2") ₺
                                        <span class="d-block vat-info">(KDV: @item.LineVat.ToString("N2") ₺)</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Address & Totals Sidebar -->
        <div class="col-lg-4">
            @if (Model.Address != null)
            {
                <div class="card-custom p-4 border-0 shadow-sm rounded-4 mb-4">
                    <h5 class="fw-bold mb-3"><i class="bi bi-geo-alt text-primary me-2"></i>Teslimat Adresi Snapshot</h5>
                    <strong class="d-block text-dark">@Model.Address.Title</strong>
                    <p class="mb-1 text-primary small"><i class="bi bi-person me-1"></i> @Model.Address.ContactName (@Model.Address.PhoneNumber)</p>
                    <p class="text-secondary small mb-0">
                        @Model.Address.AddressLine1
                        @if (!string.IsNullOrEmpty(Model.Address.AddressLine2))
                        {
                            <br />@Model.Address.AddressLine2
                        }
                        <br /><strong>@Model.Address.District / @Model.Address.City</strong>
                    </p>
                </div>
            }

            <div class="card-custom p-4 border-0 shadow-sm rounded-4">
                <h5 class="fw-bold mb-3">Ödeme Özeti</h5>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">Ara Toplam (KDV Hariç)</span>
                    <span class="fw-semibold">@Model.Subtotal.ToString("N2") ₺</span>
                </div>

                <div class="d-flex justify-content-between mb-2">
                    <span class="text-secondary">KDV Toplamı</span>
                    <span class="fw-semibold">@Model.VatTotal.ToString("N2") ₺</span>
                </div>

                <hr />

                <div class="d-flex justify-content-between">
                    <span class="fw-bold fs-5">Genel Toplam</span>
                    <span class="price-tag fs-4">@Model.GrandTotal.ToString("N2") ₺</span>
                </div>
            </div>
        </div>
    </div>
</div>

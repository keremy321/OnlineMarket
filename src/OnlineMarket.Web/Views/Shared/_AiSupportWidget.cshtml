@Html.AntiForgeryToken()

<!-- AI Support Floating Launcher Button -->
<button id="aiWidgetLauncher" class="ai-widget-launcher" aria-label="AI Destek Asistanı" title="AI Destek Canlı Asistan">
    <i class="bi bi-robot"></i>
    <span class="ai-launcher-pulse"></span>
    <span id="aiLauncherBadge" class="ai-launcher-badge">AI</span>
</button>

<!-- AI Support Chat Popup Box -->
<div id="aiWidgetBox" class="ai-widget-box" role="dialog" aria-labelledby="aiHeaderTitle">
    <!-- Header -->
    <div class="ai-widget-header">
        <div class="ai-header-info">
            <div class="ai-avatar-wrapper">
                <i class="bi bi-robot text-white"></i>
                <span class="ai-online-dot"></span>
            </div>
            <div>
                <h6 id="aiHeaderTitle" class="ai-header-title">OnlineMarket AI</h6>
                <p class="ai-header-subtitle"><i class="bi bi-stars me-1 text-warning"></i>7/24 Canlı Akıllı Asistan</p>
            </div>
        </div>
        <div class="ai-header-actions">
            <button id="aiWidgetClose" type="button" aria-label="Kapat" title="Kapat">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
    </div>

    <!-- Messages Container -->
    <div id="aiChatBody" class="ai-widget-body">
        <div class="ai-message bot">
            <div class="ai-message-bubble">
                Merhaba! Ben <strong>OnlineMarket Akıllı AI Asistanı</strong> 🤖<br />
                Ürün arama, kargo takibi, iade koşulları veya kampanya önerileri hakkında size yardımcı olabilirim. Nasıl yardımcı olabilirim?
            </div>
            <div class="ai-suggestions-wrapper">
                <button type="button" class="ai-chip">Kargo ücretleri nedir?</button>
                <button type="button" class="ai-chip">Sipariş takibi</button>
                <button type="button" class="ai-chip">Popüler ürün önerileri</button>
                <button type="button" class="ai-chip">İade ve Değişim</button>
            </div>
            <div class="ai-message-time">Şimdi</div>
        </div>
    </div>

    <!-- Footer Input Area -->
    <div class="ai-widget-footer">
        <input id="aiInputField" type="text" class="ai-input-field" placeholder="Bir soru sorun veya ürün arayın..." autocomplete="off" maxLength="500" />
        <button id="aiSendBtn" type="button" class="ai-send-btn" title="Gönder">
            <i class="bi bi-send-fill"></i>
        </button>
    </div>
</div>

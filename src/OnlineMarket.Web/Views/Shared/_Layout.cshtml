@using OnlineMarket.Web.Application.Interfaces
@inject ICartService CartService
@inject IAuthService AuthService

@{
    int cartCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var customer = await AuthService.GetCustomerByEmailAsync(User.Identity.Name ?? "");
        if (customer != null)
        {
            var cart = await CartService.GetOrCreateActiveCartAsync(customer.Id);
            cartCount = cart.Items.Sum(i => i.Quantity);
        }
    }
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Online Market</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.2/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <!-- Top Announcement Bar -->
    <div class="top-announcement-bar py-1 text-center text-white small fw-medium">
        <i class="bi bi-truck me-1"></i> 500 ₺ ve Üzeri Siparişlerde <strong>Ücretsiz Ekspres Kargo</strong> | <i class="bi bi-stars ms-2 me-1"></i> Akıllı Tavsiye Motoru Aktif
    </div>

    <!-- Main Navigation Header -->
    <header class="navbar-custom">
        <div class="container d-flex align-items-center justify-content-between">
            <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                <div class="brand-icon-wrapper">
                    <i class="bi bi-bag-heart-fill"></i>
                </div>
                <span>OnlineMarket</span>
            </a>

            <!-- Search Form -->
            <form class="d-none d-md-flex align-items-center me-3" style="max-width: 480px; flex: 1;" asp-controller="Catalog" asp-action="Index" method="get">
                <div class="input-group shadow-sm rounded-pill overflow-hidden border">
                    <input type="text" name="searchQuery" class="form-control border-0 ps-4 py-2" placeholder="Taze meyve, süt, organik ürün ara..." value="@Context.Request.Query["searchQuery"]" />
                    <button class="btn btn-primary-custom px-4 border-0" type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </form>

            <div class="d-flex align-items-center gap-3">
                <a class="btn btn-outline-dark rounded-pill px-3 py-2 position-relative font-weight-bold d-flex align-items-center gap-2 shadow-xs" asp-controller="Cart" asp-action="Index">
                    <i class="bi bi-cart3 fs-5 text-primary"></i>
                    <span class="d-none d-sm-inline">Sepetim</span>
                    @if (cartCount > 0)
                    {
                        <span class="cart-badge">@cartCount</span>
                    }
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="btn btn-primary-custom rounded-pill dropdown-toggle px-3 py-2 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-person-circle fs-5"></i>
                            <span class="d-none d-sm-inline">Hesabım</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 rounded-4 mt-2 p-2">
                            <li><a class="dropdown-item rounded-3 py-2" asp-controller="Address" asp-action="Index"><i class="bi bi-geo-alt me-2 text-primary"></i>Adreslerim</a></li>
                            <li><a class="dropdown-item rounded-3 py-2" asp-controller="Orders" asp-action="Index"><i class="bi bi-box-seam me-2 text-success"></i>Siparişlerim</a></li>
                            @if (User.IsInRole("Admin"))
                            {
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item rounded-3 py-2 text-primary font-weight-bold" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Admin Paneli</a></li>
                            }
                            <li><hr class="dropdown-divider"></li>
                            <li>
                                <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="dropdown-item rounded-3 py-2 text-danger"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-primary rounded-pill px-3 py-2 font-weight-bold" asp-controller="Account" asp-action="Login">Giriş Yap</a>
                    <a class="btn btn-primary-custom rounded-pill px-3 py-2 font-weight-bold" asp-controller="Account" asp-action="Register">Kayıt Ol</a>
                }
            </div>
        </div>

        <!-- Secondary Categories Sub-Navbar -->
        <nav class="category-subnav mt-2 pt-2 border-top">
            <div class="container d-flex align-items-center gap-3 overflow-x-auto py-1 scrollbar-hidden">
                <a asp-controller="Home" asp-action="Index" class="nav-sublink active"><i class="bi bi-house-door-fill me-1"></i> Ana Sayfa</a>
                <a asp-controller="Catalog" asp-action="Index" class="nav-sublink"><i class="bi bi-grid-fill me-1"></i> Tüm Ürünler</a>
                <a asp-controller="Catalog" asp-action="Index" asp-route-searchQuery="Meyve" class="nav-sublink"><i class="bi bi-apple me-1 text-danger"></i> Meyve & Sebze</a>
                <a asp-controller="Catalog" asp-action="Index" asp-route-searchQuery="Süt" class="nav-sublink"><i class="bi bi-cup-hot-fill me-1 text-primary"></i> Süt & Kahvaltılık</a>
                <a asp-controller="Catalog" asp-action="Index" asp-route-searchQuery="Pirinç" class="nav-sublink"><i class="bi bi-box-seam-fill me-1 text-warning"></i> Temel Gıda</a>
                <a asp-controller="Catalog" asp-action="Index" asp-route-searchQuery="Maden Suyu" class="nav-sublink"><i class="bi bi-water me-1 text-info"></i> İçecekler</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="recommendations" class="nav-sublink text-primary font-weight-bold"><i class="bi bi-stars me-1"></i> Sana Özel Öneriler</a>
            </div>
        </nav>
    </header>

    <main class="container animate-fade-in py-4">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 border-start border-success border-4" role="alert">
                <i class="bi bi-check-circle-fill me-2 fs-5"></i> @TempData["SuccessMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm mb-4 border-0 border-start border-danger border-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i> @TempData["ErrorMessage"]
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        @RenderBody()
    </main>

    <footer class="footer-custom mt-auto pt-5 pb-4">
        <div class="container">
            <div class="row g-4 mb-4">
                <div class="col-lg-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <div class="brand-icon-wrapper">
                            <i class="bi bi-bag-heart-fill"></i>
                        </div>
                        <span class="fs-4 fw-extrabold text-dark">OnlineMarket</span>
                    </div>
                    <p class="text-secondary small">
                        Uyumsoft ekosistemiyle tam entegre, yapay zeka destekli V1 akıllı öneri motoru ve anlık stok yönetimine sahip nesil market platformu.
                    </p>
                    <div class="d-flex gap-2">
                        <span class="badge bg-light text-dark border"><i class="bi bi-shield-check text-success me-1"></i> OWASP Güvenli</span>
                        <span class="badge bg-light text-dark border"><i class="bi bi-cpu-fill text-primary me-1"></i> .NET 10 & EF Core</span>
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <h6 class="fw-bold text-dark mb-3">Hızlı Bağlantılar</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2 mb-0">
                        <li><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Ana Sayfa</a></li>
                        <li><a asp-controller="Catalog" asp-action="Index" class="text-decoration-none text-secondary">Ürün Kataloğu</a></li>
                        <li><a asp-controller="Cart" asp-action="Index" class="text-decoration-none text-secondary">Sepetim</a></li>
                        <li><a asp-controller="Orders" asp-action="Index" class="text-decoration-none text-secondary">Sipariş Takibi</a></li>
                    </ul>
                </div>
                <div class="col-6 col-lg-3">
                    <h6 class="fw-bold text-dark mb-3">Öneri Sistemleri</h6>
                    <ul class="list-unstyled text-secondary small d-flex flex-column gap-2 mb-0">
                        <li><span class="text-secondary"><i class="bi bi-fire text-warning me-1"></i> Popüler Ürünler</span></li>
                        <li><span class="text-secondary"><i class="bi bi-basket-fill text-success me-1"></i> Sıklıkla Birlikte Alınanlar</span></li>
                        <li><span class="text-secondary"><i class="bi bi-heart-fill text-danger me-1"></i> Kişiselleştirilmiş Tavsiyeler</span></li>
                        <li><span class="text-secondary"><i class="bi bi-tags-fill text-info me-1"></i> Benzer Ürün Alternatifleri</span></li>
                        <li><span class="text-secondary"><i class="bi bi-bag-plus-fill text-primary me-1"></i> Sepet Tamamlama</span></li>
                    </ul>
                </div>
                <div class="col-lg-3">
                    <h6 class="fw-bold text-dark mb-3">Güvenli Ödeme & Teslimat</h6>
                    <p class="text-secondary small">Tüm işlemler KDV ayrıştırmalı ve ERP entegrasyonlu outbox mekanizması ile güvence altındadır.</p>
                    <div class="d-flex align-items-center gap-2 fs-3 text-secondary">
                        <i class="bi bi-credit-card"></i>
                        <i class="bi bi-qr-code-scan"></i>
                        <i class="bi bi-box-seam"></i>
                    </div>
                </div>
            </div>
            <hr class="border-secondary opacity-20 my-4">
            <div class="d-flex flex-column flex-sm-row align-items-center justify-content-between text-secondary small">
                <p class="mb-0">&copy; @DateTime.UtcNow.Year OnlineMarket — Uyumsoft Projesi. Tüm Hakları Saklıdır.</p>
                <div class="d-flex gap-3 mt-2 mt-sm-0">
                    <span>Gizlilik Politikası</span>
                    <span>Kullanım Koşulları</span>
                    <span>ERP API Entegrasyonu</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

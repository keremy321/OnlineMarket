@model OnlineMarket.Web.Models.RegisterViewModel
@{
    ViewData["Title"] = "Kayıt Ol";
}

<div class="row justify-content-center my-5">
    <div class="col-md-6">
        <div class="card-custom p-4 shadow-lg border-0">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus display-4 text-primary"></i>
                <h3 class="fw-bold mt-2">Yeni Hesap Oluştur</h3>
                <p class="text-secondary small">OnlineMarket ayrıcalıklarından faydalanmak için ücretsiz kaydolun.</p>
            </div>

            <form asp-action="Register" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label fw-semibold">Ad</label>
                        <input asp-for="FirstName" class="form-control rounded-3" placeholder="Adınız" />
                        <span asp-validation-for="FirstName" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label fw-semibold">Soyad</label>
                        <input asp-for="LastName" class="form-control rounded-3" placeholder="Soyadınız" />
                        <span asp-validation-for="LastName" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label fw-semibold">E-posta Adresi</label>
                    <input asp-for="Email" class="form-control rounded-3" placeholder="ornek@email.com" />
                    <span asp-validation-for="Email" class="text-danger small"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Password" class="form-label fw-semibold">Şifre</label>
                        <input asp-for="Password" class="form-control rounded-3" placeholder="En az 8 karakter" />
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6 mb-4">
                        <label asp-for="ConfirmPassword" class="form-label fw-semibold">Şifre Tekrarı</label>
                        <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="Şifrenizi tekrar girin" />
                        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary-custom w-100 py-2 rounded-3">Kayıt Ol</button>
            </form>

            <div class="text-center mt-4 pt-3 border-top">
                <p class="mb-0 text-secondary">Zaten bir hesabınız var mı? <a asp-action="Login" class="text-primary fw-bold text-decoration-none">Giriş Yapın</a></p>
            </div>
        </div>
    </div>
</div>

@model OnlineMarket.Web.Models.HomeViewModel
@{
    ViewData["Title"] = "Ana Sayfa — Taze & Hızlı Online Market";
}

<!-- Hero Banner Section -->
<section class="mb-4 mb-md-5">
    <div class="hero-card text-white p-3 p-md-5 position-relative">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                    <span class="badge bg-warning text-dark font-weight-bold px-3 py-2 rounded-pill">
                        <i class="bi bi-lightning-fill me-1"></i> 30 DAKİKADA EKSPRES TESLİMAT
                    </span>
                    <span class="badge bg-success bg-opacity-75 text-white font-weight-bold px-3 py-2 rounded-pill">
                        <i class="bi bi-shield-check me-1"></i> %100 TAZE GARANTİSİ
                    </span>
                </div>
                <h1 class="display-5 display-md-4 fw-extrabold mb-3 text-white">Taptaze Market Ürünleri Kapınızda!</h1>
                <p class="fs-6 fs-md-5 opacity-90 mb-4 text-light">
                    Yerli üreticilerden taze meyve ve sebzeler, süt ürünleri ve temel gıdalar V1 akıllı öneri algoritması desteğiyle tek tıkla kapınızda.
                </p>

                <!-- Search inside Hero -->
                <form asp-controller="Catalog" asp-action="Index" method="get" class="mb-4">
                    <div class="input-group input-group-lg bg-white p-1 rounded-pill shadow-lg style-search-hero">
                        <span class="input-group-text bg-transparent border-0 text-muted ps-3">
                            <i class="bi bi-search fs-5"></i>
                        </span>
                        <input type="text" name="searchQuery" class="form-control border-0 bg-transparent fs-6" placeholder="Meyve, süt, peynir, kahvaltılık ara..." />
                        <button type="submit" class="btn btn-primary-custom rounded-pill px-3 px-sm-4 font-weight-bold">
                            Ürün Ara
                        </button>
                    </div>
                </form>

                <div class="d-flex flex-column flex-sm-row gap-2 gap-sm-3">
                    <a asp-controller="Catalog" asp-action="Index" class="btn btn-light text-primary btn-lg px-4 py-3 font-weight-bold rounded-pill shadow-sm text-center">
                        <i class="bi bi-bag-check-fill me-2 text-primary"></i>Alışverişe Başla
                    </a>
                    @if (Model.PersonalizedRecommendations.Any())
                    {
                        <a href="#personalized-recommendations" class="btn btn-outline-light btn-lg px-4 py-3 font-weight-bold rounded-pill text-center">
                            <i class="bi bi-stars me-2"></i>Sana Özel Öneriler
                        </a>
                    }
                    else
                    {
                        <a href="#recommendations" class="btn btn-outline-light btn-lg px-4 py-3 font-weight-bold rounded-pill text-center">
                            <i class="bi bi-stars me-2"></i>Akıllı Öneriler
                        </a>
                    }
                </div>
            </div>

            <div class="col-lg-5 d-none d-lg-block text-center position-relative">
                <div class="bg-white bg-opacity-10 backdrop-blur rounded-circle p-5 d-inline-block shadow-lg border border-white border-opacity-20">
                    <i class="bi bi-basket-fill display-1 text-warning"></i>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Category Showcase Grid -->
@if (Model.Categories.Any())
{
    <section class="mb-5">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h3 class="fw-extrabold mb-1 text-dark">Kategoriler</h3>
                <p class="text-secondary small mb-0">Market ihtiyaçlarınıza göre ana kategorilere ve alt ürün gruplarına göz atın</p>
            </div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-sm btn-outline-primary rounded-pill px-3 font-weight-bold">
                Tüm Kataloğu İncele <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var cat in Model.Categories.Where(c => c.ParentCategoryId == null))
            {
                <div class="col-12 col-md-6 col-lg-4">
                    <div class="card-custom h-100 p-4 bg-white border-0 shadow-sm rounded-4 d-flex flex-column transition-all">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="bg-success bg-opacity-10 text-success rounded-circle p-3 d-flex align-items-center justify-content-center flex-shrink-0" style="width: 56px; height: 56px;">
                                @if (cat.Name.Contains("Gıda") || cat.Name.Contains("Temel"))
                                {
                                    <i class="bi bi-basket2-fill fs-3 text-success"></i>
                                }
                                else if (cat.Name.Contains("İçecek"))
                                {
                                    <i class="bi bi-cup-straw fs-3 text-primary"></i>
                                }
                                else if (cat.Name.Contains("Atıştırmalık"))
                                {
                                    <i class="bi bi-cookie fs-3 text-warning"></i>
                                }
                                else if (cat.Name.Contains("Temizlik"))
                                {
                                    <i class="bi bi-stars fs-3 text-info"></i>
                                }
                                else if (cat.Name.Contains("Bebek"))
                                {
                                    <i class="bi bi-emoji-smile-fill fs-3 text-danger"></i>
                                }
                                else if (cat.Name.Contains("Fırın"))
                                {
                                    <i class="bi bi-cake2-fill fs-3 text-warning"></i>
                                }
                                else if (cat.Name.Contains("Şarküteri"))
                                {
                                    <i class="bi bi-egg-fried fs-3 text-danger"></i>
                                }
                                else
                                {
                                    <i class="bi bi-grid-fill fs-3 text-success"></i>
                                }
                            </div>
                            <div class="overflow-hidden">
                                <h5 class="fw-bold mb-0 text-dark text-truncate">
                                    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@cat.Id" class="text-dark text-decoration-none hv-primary">@cat.Name</a>
                                </h5>
                                <span class="text-secondary small">@(cat.SubCategories?.Count ?? 0) Alt Kategori</span>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mb-3">
                            @if (cat.SubCategories != null && cat.SubCategories.Any())
                            {
                                @foreach (var sub in cat.SubCategories)
                                {
                                    <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@sub.Id" class="badge bg-light text-dark border border-secondary-subtle px-3 py-2 rounded-pill fw-semibold text-decoration-none hover-shadow">
                                        <i class="bi bi-tag-fill me-1 text-success extra-small"></i>@sub.Name
                                    </a>
                                }
                            }
                            else
                            {
                                <span class="text-muted extra-small">Tüm ürünler ana kategoride</span>
                            }
                        </div>

                        <div class="mt-auto pt-3 border-top d-flex align-items-center justify-content-between">
                            <span class="text-secondary extra-small font-weight-bold">Ana Kategori</span>
                            <a asp-controller="Catalog" asp-action="Index" asp-route-categoryId="@cat.Id" class="btn btn-sm btn-outline-success rounded-pill px-3 font-weight-bold">
                                Tümünü Gör <i class="bi bi-chevron-right ms-1"></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </section>
}

@if (Model.PersonalizedRecommendations.Any())
{
    <section class="mb-5" id="personalized-recommendations">
        <div class="d-flex align-items-center justify-content-between mb-4">
            <div>
                <h2 class="fw-extrabold mb-1 text-dark">Sana Özel Öneriler</h2>
                <p class="text-secondary small mb-0">Alışveriş geçmişine göre seçilen, güncel ve stokta olan ürünler</p>
            </div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 font-weight-bold">
                Tüm Kataloğu İncele <i class="bi bi-grid me-1"></i>
            </a>
        </div>

        <div class="row g-4">
            @foreach (var recommendation in Model.PersonalizedRecommendations)
            {
                if (recommendation.ProductDetails is { } product)
                {
                    <div class="col-6 col-md-4 col-lg-3">
                        <partial name="_ProductCard" model="product" />
                    </div>
                }
            }
        </div>
    </section>
}

<!-- 5 Recommendation Engine V1 Showcase -->
<section class="mb-5" id="recommendations">
    <div class="card-custom p-4 bg-white border-0 shadow-sm rounded-4">
        <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-2">
            <div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill fw-bold">
                        <i class="bi bi-cpu-fill me-1"></i> Akıllı Öneri Motoru V1
                    </span>
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill fw-bold">
                        5 Öneri Tipi
                    </span>
                </div>
                <h2 class="fw-extrabold mt-2 mb-1 text-dark">Sizin İçin Seçtiklerimiz</h2>
                <p class="text-secondary small mb-0">Güncel katalog ve alışveriş eğilimlerinden hesaplanan akıllı tavsiyeler</p>
            </div>
            <a asp-controller="Catalog" asp-action="Index" class="btn btn-sm btn-outline-success rounded-pill fw-semibold px-3 py-2">
                Tüm Kataloğu Gör <i class="bi bi-arrow-right ms-1"></i>
            </a>
        </div>

        <div class="row g-4">
            <!-- 1. Popular Product -->
            @if (Model.PopularRecommendations.Any())
            {
                var pop = Model.PopularRecommendations.First();
                if (pop.ProductDetails != null)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-warning border-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge badge-popular px-2 py-1 rounded-pill"><i class="bi bi-fire me-1"></i> Popüler Ürün</span>
                                <span class="badge bg-light text-dark border font-mono">Skor: @pop.Score.ToString("F1")</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt-2">
                                <img src="@(string.IsNullOrEmpty(pop.ProductDetails.ImageUrl) ? "https://placehold.co/120x120?text=Urun" : pop.ProductDetails.ImageUrl)" class="rounded-3" style="width: 70px; height: 70px; object-fit: contain;" alt="@pop.ProductDetails.Name" />
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@pop.ProductDetails.Id" class="text-dark text-decoration-none">@pop.ProductDetails.Name</a>
                                    </h6>
                                    <span class="text-secondary small d-block">@pop.ProductDetails.BrandName</span>
                                    <div class="mt-1">
                                        <span class="fw-extrabold text-success fs-5">@pop.ProductDetails.Price.ToString("N2") ₺</span>
                                        <span class="vat-info ms-1">(+%@pop.ProductDetails.VatRate KDV)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                                <span class="text-secondary extra-small"><i class="bi bi-info-circle me-1 text-warning"></i> En çok tercih edilen ürün</span>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@pop.ProductDetails.Id" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 font-weight-bold"><i class="bi bi-plus-lg me-1"></i> Ekle</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- 2. Frequently Bought Together -->
            @if (Model.FrequentlyBoughtTogether.Any())
            {
                var fbt = Model.FrequentlyBoughtTogether.First();
                if (fbt.ProductDetails != null)
                {
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-success border-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge badge-together px-2 py-1 rounded-pill"><i class="bi bi-basket-fill me-1"></i> Birlikte Alınan</span>
                                <span class="badge bg-light text-dark border font-mono">Uyumlu</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt-2">
                                <img src="@(string.IsNullOrEmpty(fbt.ProductDetails.ImageUrl) ? "https://placehold.co/120x120?text=Urun" : fbt.ProductDetails.ImageUrl)" class="rounded-3" style="width: 70px; height: 70px; object-fit: contain;" alt="@fbt.ProductDetails.Name" />
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@fbt.ProductDetails.Id" class="text-dark text-decoration-none">@fbt.ProductDetails.Name</a>
                                    </h6>
                                    <span class="text-secondary small d-block">@fbt.ProductDetails.CategoryName</span>
                                    <div class="mt-1">
                                        <span class="fw-extrabold text-success fs-5">@fbt.ProductDetails.Price.ToString("N2") ₺</span>
                                        <span class="vat-info ms-1">(+%@fbt.ProductDetails.VatRate KDV)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                                <span class="text-secondary extra-small"><i class="bi bi-info-circle me-1 text-success"></i> Sıklıkla sepetlerde birlikte alınıyor</span>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@fbt.ProductDetails.Id" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 font-weight-bold"><i class="bi bi-plus-lg me-1"></i> Ekle</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- 3. Similar Recommendation -->
            @if (Model.SimilarProducts.Any())
            {
                var sim = Model.SimilarProducts.First();
                if (sim.ProductDetails != null)
                {
                    <div class="col-md-6 col-lg-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-primary border-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge badge-similar px-2 py-1 rounded-pill"><i class="bi bi-tags-fill me-1"></i> Benzer Ürün Alternatifi</span>
                                <span class="badge bg-light text-dark border font-mono">Benzerlik Yüksek</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt-2">
                                <img src="@(string.IsNullOrEmpty(sim.ProductDetails.ImageUrl) ? "https://placehold.co/120x120?text=Urun" : sim.ProductDetails.ImageUrl)" class="rounded-3" style="width: 70px; height: 70px; object-fit: contain;" alt="@sim.ProductDetails.Name" />
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@sim.ProductDetails.Id" class="text-dark text-decoration-none">@sim.ProductDetails.Name</a>
                                    </h6>
                                    <span class="text-secondary small d-block">@sim.ProductDetails.CategoryName</span>
                                    <div class="mt-1">
                                        <span class="fw-extrabold text-success fs-5">@sim.ProductDetails.Price.ToString("N2") ₺</span>
                                        <span class="vat-info ms-1">(+%@sim.ProductDetails.VatRate KDV)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                                <span class="text-secondary extra-small"><i class="bi bi-info-circle me-1 text-primary"></i> İncelediğiniz ürün grubuyla benzer</span>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@sim.ProductDetails.Id" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 font-weight-bold"><i class="bi bi-plus-lg me-1"></i> Ekle</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }

            <!-- 4. Cart Completion Recommendation -->
            @if (Model.CartCompletionRecommendations.Any())
            {
                var cartComp = Model.CartCompletionRecommendations.First();
                if (cartComp.ProductDetails != null)
                {
                    <div class="col-md-6 col-lg-6">
                        <div class="card border-0 shadow-sm rounded-4 h-100 p-3 bg-white border-start border-info border-4">
                            <div class="d-flex align-items-center justify-content-between mb-2">
                                <span class="badge badge-cart-completion px-2 py-1 rounded-pill"><i class="bi bi-bag-plus-fill me-1"></i> Sepet Tamamlama</span>
                                <span class="badge bg-light text-dark border font-mono">Tamamlayıcı</span>
                            </div>
                            <div class="d-flex align-items-center gap-3 mt-2">
                                <img src="@(string.IsNullOrEmpty(cartComp.ProductDetails.ImageUrl) ? "https://placehold.co/120x120?text=Urun" : cartComp.ProductDetails.ImageUrl)" class="rounded-3" style="width: 70px; height: 70px; object-fit: contain;" alt="@cartComp.ProductDetails.Name" />
                                <div>
                                    <h6 class="fw-bold mb-1 text-dark">
                                        <a asp-controller="Catalog" asp-action="Details" asp-route-id="@cartComp.ProductDetails.Id" class="text-dark text-decoration-none">@cartComp.ProductDetails.Name</a>
                                    </h6>
                                    <span class="text-secondary small d-block">@cartComp.ProductDetails.BrandName</span>
                                    <div class="mt-1">
                                        <span class="fw-extrabold text-success fs-5">@cartComp.ProductDetails.Price.ToString("N2") ₺</span>
                                        <span class="vat-info ms-1">(+%@cartComp.ProductDetails.VatRate KDV)</span>
                                    </div>
                                </div>
                            </div>
                            <div class="mt-3 pt-2 border-top d-flex align-items-center justify-content-between">
                                <span class="text-secondary extra-small"><i class="bi bi-info-circle me-1 text-info"></i> Sepetinizdeki ürünleri mükemmel tamamlar</span>
                                <form asp-controller="Cart" asp-action="AddToCart" method="post">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="productId" value="@cartComp.ProductDetails.Id" />
                                    <button type="submit" class="btn btn-sm btn-success rounded-pill px-3 font-weight-bold"><i class="bi bi-plus-lg me-1"></i> Ekle</button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Featured Products Showcase -->
<section class="mb-5">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h3 class="fw-extrabold mb-1 text-dark">Öne Çıkan Market Ürünleri</h3>
            <p class="text-secondary small mb-0">En son eklenen ve anlık stokta olan taze ürünler</p>
        </div>
        <a asp-controller="Catalog" asp-action="Index" class="btn btn-outline-primary rounded-pill px-4 font-weight-bold">
            Tüm Kataloğu İncele <i class="bi bi-grid me-1"></i>
        </a>
    </div>

    <div class="row g-4">
        @foreach (var product in Model.FeaturedProducts)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <partial name="_ProductCard" model="product" />
            </div>
        }
    </div>
</section>

<!-- Features & Value Proposition -->
<section class="mb-4">
    <div class="row g-3 g-md-4">
        <div class="col-6 col-md-3">
            <div class="feature-card h-100 text-center p-3">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle p-2 p-md-3 d-inline-flex align-items-center justify-content-center mb-2 mb-md-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-lightning-charge-fill fs-4"></i>
                </div>
                <h6 class="fw-bold mb-1 fs-6">Ekspres Teslimat</h6>
                <p class="text-secondary small mb-0 d-none d-sm-block">Siparişiniz 30 dakika içerisinde özel soğutmalı araçlarla kapınızda.</p>
                <p class="text-secondary extra-small mb-0 d-sm-none">30 dk içinde kapınızda.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="feature-card h-100 text-center p-3">
                <div class="bg-success bg-opacity-10 text-success rounded-circle p-2 p-md-3 d-inline-flex align-items-center justify-content-center mb-2 mb-md-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-shield-check fs-4"></i>
                </div>
                <h6 class="fw-bold mb-1 fs-6">%100 Taze</h6>
                <p class="text-secondary small mb-0 d-none d-sm-block">Yerli çiftçi ve üreticilerden günlük tedarik edilen taze ürünler.</p>
                <p class="text-secondary extra-small mb-0 d-sm-none">Günlük taze ürünler.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="feature-card h-100 text-center p-3">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle p-2 p-md-3 d-inline-flex align-items-center justify-content-center mb-2 mb-md-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-cpu-fill fs-4"></i>
                </div>
                <h6 class="fw-bold mb-1 fs-6">V1 Akıllı Öneri</h6>
                <p class="text-secondary small mb-0 d-none d-sm-block">Alışkanlıklarınıza ve sepetlerinize özel kişiselleştirilmiş ürün tavsiyeleri.</p>
                <p class="text-secondary extra-small mb-0 d-sm-none">Kişisel tavsiyeler.</p>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="feature-card h-100 text-center p-3">
                <div class="bg-info bg-opacity-10 text-info rounded-circle p-2 p-md-3 d-inline-flex align-items-center justify-content-center mb-2 mb-md-3" style="width: 50px; height: 50px;">
                    <i class="bi bi-box-seam-fill fs-4"></i>
                </div>
                <h6 class="fw-bold mb-1 fs-6">ERP Entegrasyonu</h6>
                <p class="text-secondary small mb-0 d-none d-sm-block">Siparişleriniz KDV detayları ve stok hareketleri ile anında ERP'ye aktarılır.</p>
                <p class="text-secondary extra-small mb-0 d-sm-none">Anında ERP aktarımı.</p>
            </div>
        </div>
    </div>
</section>
